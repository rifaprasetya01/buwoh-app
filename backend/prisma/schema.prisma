generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Address {
  id          String   @id @default(uuid())
  street      String?  @db.VarChar(255)
  rt_rw       String?  @db.VarChar(20)
  village     String?  @db.VarChar(100)
  district    String?  @db.VarChar(100)
  city        String?  @db.VarChar(100)
  province    String?  @db.VarChar(100)
  postal_code String?  @db.VarChar(10)
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  events      Event[]  @relation("EventAddress")
  users       User[]

  @@map("addresses")
}

model User {
  id           String       @id @default(uuid())
  addressId    String?      @map("address_id")
  name         String       @db.VarChar(255)
  email        String       @unique @db.VarChar(255)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  birthDate    DateTime?    @map("birth_date") @db.Date
  photoUrl     String?      @map("photo_url") @db.VarChar(512)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")
  guestEvents  EventGuest[]
  eventsHosted Event[]
  address      Address?     @relation(fields: [addressId], references: [id])

  @@index([addressId], map: "users_address_id_fkey")
  @@map("users")
}

model Event {
  id                    String                      @id @default(uuid())
  hostId                String                      @map("host_id")
  title                 String                      @db.VarChar(255)
  eventType             String                      @map("event_type") @db.VarChar(100)
  eventDate             DateTime                    @map("event_date") @db.Date
  startTime             DateTime?                   @map("start_time") @db.Time(0)
  endTime               DateTime?                   @map("end_time") @db.Time(0)
  locationName          String                      @map("location_name") @db.VarChar(255)
  mapLink               String?                     @map("map_link") @db.VarChar(512)
  description           String?                     @db.Text
  coverImageUrl         String?                     @map("cover_image_url") @db.VarChar(512)
  status                String                      @default("active") @db.VarChar(50)
  isPriority            Boolean                     @default(false) @map("is_priority")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  deletedAt             DateTime?                   @map("deleted_at")
  addressId             String?                     @map("address_id")
  expectedContributions EventExpectedContribution[]
  guests                EventGuest[]
  address               Address?                    @relation("EventAddress", fields: [addressId], references: [id])
  host                  User                        @relation(fields: [hostId], references: [id])

  @@index([hostId])
  @@index([eventDate, status])
  @@index([addressId], map: "events_address_id_fkey")
  @@map("events")
}

model EventExpectedContribution {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  itemType  String   @map("item_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("event_expected_contributions")
}

model EventGuest {
  id            String         @id @default(uuid())
  eventId       String         @map("event_id")
  guestId       String         @map("guest_id")
  status        String         @default("pending") @db.VarChar(50)
  timeArrived   DateTime?      @map("time_arrived")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  contributions Contribution[]
  event         Event          @relation(fields: [eventId], references: [id])
  guest         User           @relation(fields: [guestId], references: [id])

  @@unique([eventId, guestId])
  @@index([eventId])
  @@index([guestId])
  @@index([status])
  @@map("event_guests")
}

model Contribution {
  id           String     @id @default(uuid())
  eventGuestId String     @map("event_guest_id")
  itemType     String     @map("item_type") @db.VarChar(100)
  amount       Decimal    @db.Decimal(15, 2)
  unit         String     @db.VarChar(50)
  notes        String?    @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  eventGuest   EventGuest @relation(fields: [eventGuestId], references: [id])

  @@index([eventGuestId])
  @@map("contributions")
}
